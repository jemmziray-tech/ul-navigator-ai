# ---------------------------------------------------------------------------
# UL Navigator AI - environment variables. Copy to `.env` and fill in.
# NEVER commit your real .env file. Placeholders only below.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=data                       # SQLite DB, FAISS index, raw cache, logs, reports
# DATABASE_URL=postgresql://user:password@host:5432/ul_navigator   # optional; default SQLite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SENTRY_DSN=

# --- Gemini (https://aistudio.google.com/apikey) ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash       # list available models: python -m app.cli models
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_S=45
GEMINI_MAX_RETRIES=3

# --- Embeddings & reranking -------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | hash (tests/offline only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # ~130 MB, 384-d
EMBEDDING_DEVICE=auto                     # auto (CUDA if available) | cuda | cpu
EMBEDDING_BATCH_SIZE=64                   # lower to 16-32 if you run out of GPU memory
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# MODEL_CACHE_DIR=D:/hf-cache             # optional: keep model downloads off C:

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=40
MIN_RERANK_PROBABILITY=0.12
MIN_SEMANTIC_SCORE=0.50

# --- Crawler -------------------------------------------------------------------
CRAWL_USER_AGENT=ULNavigatorAI/1.0 (independent student project; contact: your-email@example.com)
CRAWL_DELAY_S=3.0
CRAWL_CACHE_TTL_HOURS=12            # reuse pages downloaded within this window
CRAWL_MAX_PAGES=150
CRAWL_MAX_DEPTH=2
CRAWL_USE_PLAYWRIGHT=false

# --- Admin (generate with the commands below) -------------------------------
ADMIN_USERNAME=admin
# python -m app.security hash-password   (run inside backend/)
ADMIN_PASSWORD_HASH=
# python -m app.security jwt-secret
JWT_SECRET=
JWT_EXPIRY_MINUTES=480

# --- Abuse protection & privacy ---------------------------------------------
RATE_LIMIT_CHAT=3/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
TRUST_PROXY_HEADERS=false           # true behind Render/NGINX so rate limits use the client IP
MAX_UPLOAD_MB=25
RETENTION_DAYS=90                   # conversations and query logs older than this are deleted
STORE_CONVERSATIONS=true

# --- Frontend (frontend/.env.local) -----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
